# Docker Compose host port mapping.
# The app listens on LIBREDESK_CONTAINER_PORT inside the container.
LIBREDESK_BIND_ADDR=127.0.0.1
LIBREDESK_PORT=9000
LIBREDESK_CONTAINER_PORT=9000

# Set on first `docker compose up` to initialize the System user password.
LIBREDESK_SYSTEM_USER_PASSWORD=

# Optional: WAGO settings. You can also put these in config.toml.
# LIBREDESK_WAGO__BASE_URL=https://wago.example.com
# LIBREDESK_WAGO__DEVICE_ID=your-wago-device-id
# LIBREDESK_WAGO__USERNAME=wago-basic-auth-user
# LIBREDESK_WAGO__PASSWORD=wago-basic-auth-password
# LIBREDESK_WAGO__WEBHOOK_SECRET=same-value-as-WHATSAPP_WEBHOOK_SECRET
